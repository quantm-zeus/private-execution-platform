{
  "name": "private-execution-web",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build:public": "pnpm --filter @evergreen/public build",
    "build:workspace-shell": "pnpm --filter @evergreen/workspace-shell build",
    "build:workspace-payload": "pnpm --filter @evergreen/workspace-payload build",
    "build:workspace": "pnpm --filter @evergreen/workspace-payload build",
    "typecheck": "pnpm -r typecheck",
    "test:web": "pnpm --filter @evergreen/workspace-payload test",
    "test:shell": "pnpm --filter @evergreen/workspace-shell test",
    "test:e2e": "pnpm build:workspace-payload && pnpm build:workspace-shell && PLAYWRIGHT_BROWSERS_PATH=0 pnpm --filter @evergreen/e2e test:e2e",
    "build:crypto-wasm-bindings": "node scripts/build-crypto-wasm-bindings.mjs",
    "build:workspace:encrypted": "node scripts/build-workspace-encrypted.mjs",
    "verify:web-boundary": "node scripts/verify-web-boundary.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "@types/node": "26.5.0"
  }
}
